        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    dim_date {\n        int date_key PK \&quot;yyyyMMdd format\&quot;\n        date full_date \&quot;Full calendar date\&quot;\n        int year \&quot;Calendar Year\&quot;\n        int quarter \&quot;Quarter (1-4)\&quot;\n        int month \&quot;Month (1-12)\&quot;\n        string month_name \&quot;Full Month Name\&quot;\n        int day_of_month \&quot;Day of Month\&quot;\n        int day_of_week \&quot;Day of Week (1-7)\&quot;\n        string day_name \&quot;Day Name\&quot;\n        int day_of_year \&quot;Day of Year\&quot;\n        int week_of_year \&quot;ISO Week of Year\&quot;\n        boolean is_weekend \&quot;Weekend Flag\&quot;\n        int fiscal_year \&quot;Fiscal Year\&quot;\n        int fiscal_quarter \&quot;Fiscal Quarter\&quot;\n        int fiscal_period \&quot;Fiscal Month\&quot;\n        boolean is_month_end \&quot;Month End Flag\&quot;\n        boolean is_quarter_end \&quot;Quarter End Flag\&quot;\n        boolean is_year_end \&quot;Year End Flag\&quot;\n    }\n\n    dim_facility {\n        bigint facility_key PK \&quot;xxhash64(facility_id || effective_date)\&quot;\n        string facility_id \&quot;Natural Key (e.g. FAC-001)\&quot;\n        string facility_name \&quot;Facility Name\&quot;\n        string region \&quot;Administrative Region\&quot;\n        string city \&quot;Municipality / City\&quot;\n        double latitude \&quot;GPS Latitude\&quot;\n        double longitude \&quot;GPS Longitude\&quot;\n        double elevation_m \&quot;Elevation Meters\&quot;\n        string climate_zone \&quot;Köppen Climate Zone\&quot;\n        string water_source \&quot;Water Supply Type\&quot;\n        string power_grid_redundancy \&quot;Power Redundancy Tier\&quot;\n        int max_zone_capacity \&quot;Max Zone Racks\&quot;\n        string operator_contact \&quot;Facility Manager Email\&quot;\n        bigint attr_hash \&quot;SCD2 Change Detection Hash\&quot;\n        date effective_date \&quot;Version Effective Date\&quot;\n        date expiration_date \&quot;Version Expiration Date (9999-12-31)\&quot;\n        boolean is_current \&quot;Active Version Flag\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    dim_zone {\n        bigint zone_key PK \&quot;xxhash64(facility_id || zone_id || effective_date)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Parent Facility Key\&quot;\n        string zone_id \&quot;Natural Key (e.g. ZONE-003)\&quot;\n        string zone_name \&quot;Zone Description\&quot;\n        string section \&quot;Zone Rack Section\&quot;\n        int rack_capacity \&quot;Maximum Vertical Racks\&quot;\n        bigint attr_hash \&quot;SCD2 Change Detection Hash\&quot;\n        date effective_date \&quot;Version Effective Date\&quot;\n        date expiration_date \&quot;Version Expiration Date (9999-12-31)\&quot;\n        boolean is_current \&quot;Active Version Flag\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    dim_equipment {\n        bigint equipment_key PK \&quot;xxhash64(equipment_id || effective_date)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Parent Facility Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Parent Zone Key\&quot;\n        string equipment_id \&quot;Natural Key (e.g. EQ-00054)\&quot;\n        string equipment_type \&quot;Category (Water Pump, HVAC, LED)\&quot;\n        string manufacturer \&quot;Manufacturer Name\&quot;\n        string model_number \&quot;Hardware Model Code\&quot;\n        date installation_date \&quot;Commissioning Date\&quot;\n        bigint attr_hash \&quot;SCD2 Change Detection Hash\&quot;\n        date effective_date \&quot;Version Effective Date\&quot;\n        date expiration_date \&quot;Version Expiration Date (9999-12-31)\&quot;\n        boolean is_current \&quot;Active Version Flag\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    dim_crop {\n        bigint crop_key PK \&quot;xxhash64(crop_type)\&quot;\n        string crop_type \&quot;Natural Key (e.g. Butterhead Lettuce)\&quot;\n        double optimal_temperature_celsius \&quot;Target Growing Temp (°C)\&quot;\n        double optimal_humidity_percent \&quot;Target Relative Humidity (%)\&quot;\n        double target_biomass_g \&quot;Target Harvest Biomass (g)\&quot;\n        int harvest_cycle_days \&quot;Target Growth Days\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    dim_technician {\n        bigint technician_key PK \&quot;xxhash64(technician_name)\&quot;\n        string technician_name \&quot;Natural Key (e.g. Juan Dela Cruz)\&quot;\n        string phone_number \&quot;Hotline Phone Number\&quot;\n        string email \&quot;Technician Email Address\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_environmental_daily {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        double avg_ambient_temp_celsius \&quot;Avg Air Temp (°C)\&quot;\n        double min_ambient_temp_celsius \&quot;Min Air Temp (°C)\&quot;\n        double max_ambient_temp_celsius \&quot;Max Air Temp (°C)\&quot;\n        double avg_humidity_pct \&quot;Avg Relative Humidity (%)\&quot;\n        double avg_co2_ppm \&quot;Avg Carbon Dioxide (PPM)\&quot;\n        double avg_vpd_kpa \&quot;Avg Vapor Pressure Deficit (kPa)\&quot;\n        double avg_temp_drift_celsius \&quot;Avg Thermal Drift (°C)\&quot;\n        double avg_stability_score \&quot;Avg Stability Score\&quot;\n        double avg_water_ph \&quot;Avg Solution pH Level\&quot;\n        double avg_ec_ms_cm \&quot;Avg Electrical Conductivity (mS/cm)\&quot;\n        bigint telemetry_sample_count \&quot;Daily Sample Count\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_equipment_telemetry {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint equipment_key FK \&quot;Point-in-Time Equipment Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        double avg_health_score \&quot;Avg Mechanical Health (%)\&quot;\n        double max_failure_probability \&quot;Peak Failure Risk (0.00-1.00)\&quot;\n        double daily_runtime_hours \&quot;Daily Active Machine Hours\&quot;\n        double avg_power_draw_kw \&quot;Avg Active Power Draw (kW)\&quot;\n        double total_energy_kwh \&quot;Total Energy Consumed (kWh)\&quot;\n        double avg_vibration_vps \&quot;Avg Bearing Vibration (VPS)\&quot;\n        double avg_operating_temp_celsius \&quot;Avg Motor Casing Temp (°C)\&quot;\n        double avg_load_percent \&quot;Avg Mechanical Load (%)\&quot;\n        bigint telemetry_sample_count \&quot;Daily Sample Count\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_crop_yield {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint crop_key FK \&quot;Surrogate Cultivar Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        string crop_batch_id \&quot;Degenerate Batch Key\&quot;\n        double crop_age_days \&quot;Batch Maturity Age (Days)\&quot;\n        double current_biomass_grams \&quot;EOD Fresh Weight Biomass (g)\&quot;\n        double avg_daily_growth_rate_g_day \&quot;Avg Daily Growth Velocity\&quot;\n        double avg_biological_stress_index \&quot;Avg Stress Index (0.00-1.00)\&quot;\n        double avg_crop_health_score \&quot;Avg Plant Health (%)\&quot;\n        double daily_water_consumption_liters \&quot;Daily Root Water Uptake (L)\&quot;\n        double daily_nutrient_consumption_grams \&quot;Daily Fertilizer Uptake (g)\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_irrigation_daily {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        double total_water_delivered_liters \&quot;Total Water Delivered (L)\&quot;\n        double total_nutrient_delivered_liters \&quot;Total Solution Delivered (L)\&quot;\n        double avg_flow_rate_lpm \&quot;Avg Hydraulic Flow (L/min)\&quot;\n        double avg_pump_pressure_kpa \&quot;Avg Pump Pressure (kPa)\&quot;\n        double total_irrigation_duration_seconds \&quot;Total Valve Open Duration (s)\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_lighting_dli_daily {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        double daily_light_integral_dli \&quot;Daily Light Integral (mol/m²/day)\&quot;\n        double total_photoperiod_hours \&quot;Total Photoperiod Active Hours\&quot;\n        double avg_lighting_intensity_pct \&quot;Avg Dimming Level (%)\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_maintenance_sla {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        bigint facility_key FK \&quot;Point-in-Time Facility Key\&quot;\n        bigint equipment_key FK \&quot;Point-in-Time Equipment Key\&quot;\n        bigint zone_key FK \&quot;Point-in-Time Zone Key\&quot;\n        bigint technician_key FK \&quot;Surrogate Technician Key\&quot;\n        string work_order_id \&quot;Degenerate Ticket Key (WO-00001)\&quot;\n        string priority \&quot;Priority (ROUTINE, HIGH, EMERGENCY)\&quot;\n        string maintenance_type \&quot;Category (PREVENTATIVE, REPAIR)\&quot;\n        string maintenance_status \&quot;Status (COMPLETED, IN_PROGRESS)\&quot;\n        int estimated_duration_minutes \&quot;Target Labor Duration (Min)\&quot;\n        int actual_duration_minutes \&quot;Actual Spent Duration (Min)\&quot;\n        double completion_percent \&quot;Ticket Progress (%)\&quot;\n        double health_restored \&quot;Post-Repair Health Gain (%)\&quot;\n        bigint resolution_lag_min \&quot;Total SLA Resolution Lag (Min)\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    fact_dead_letter_governance {\n        int date_key FK \&quot;Partition Column (yyyyMMdd)\&quot;\n        string target_stream \&quot;Stream ID (e.g. equipment)\&quot;\n        string exception_category \&quot;Category (MISSING_KEY, TIMEOUT)\&quot;\n        boolean is_auto_remediable \&quot;Self-Healing Flag\&quot;\n        bigint exception_count \&quot;Daily Exception Count\&quot;\n        timestamp created_timestamp \&quot;Metadata Ingestion Timestamp\&quot;\n        date pipeline_run_date \&quot;Pipeline Execution Date\&quot;\n    }\n\n    dim_facility ||--o{ dim_zone : \&quot;facility_key\&quot;\n    dim_facility ||--o{ dim_equipment : \&quot;facility_key\&quot;\n    dim_zone ||--o{ dim_equipment : \&quot;zone_key\&quot;\n\n    dim_date ||--o{ fact_environmental_daily : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_equipment_telemetry : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_crop_yield : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_irrigation_daily : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_lighting_dli_daily : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_maintenance_sla : \&quot;date_key\&quot;\n    dim_date ||--o{ fact_dead_letter_governance : \&quot;date_key\&quot;\n\n    dim_facility ||--o{ fact_environmental_daily : \&quot;facility_key\&quot;\n    dim_facility ||--o{ fact_equipment_telemetry : \&quot;facility_key\&quot;\n    dim_facility ||--o{ fact_crop_yield : \&quot;facility_key\&quot;\n    dim_facility ||--o{ fact_irrigation_daily : \&quot;facility_key\&quot;\n    dim_facility ||--o{ fact_lighting_dli_daily : \&quot;facility_key\&quot;\n    dim_facility ||--o{ fact_maintenance_sla : \&quot;facility_key\&quot;\n\n    dim_zone ||--o{ fact_environmental_daily : \&quot;zone_key\&quot;\n    dim_zone ||--o{ fact_equipment_telemetry : \&quot;zone_key\&quot;\n    dim_zone ||--o{ fact_crop_yield : \&quot;zone_key\&quot;\n    dim_zone ||--o{ fact_irrigation_daily : \&quot;zone_key\&quot;\n    dim_zone ||--o{ fact_lighting_dli_daily : \&quot;zone_key\&quot;\n    dim_zone ||--o{ fact_maintenance_sla : \&quot;zone_key\&quot;\n\n    dim_equipment ||--o{ fact_equipment_telemetry : \&quot;equipment_key\&quot;\n    dim_equipment ||--o{ fact_maintenance_sla : \&quot;equipment_key\&quot;\n\n    dim_crop ||--o{ fact_crop_yield : \&quot;crop_key\&quot;\n\n    dim_technician ||--o{ fact_maintenance_sla : \&quot;technician_key\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NrNuTGUhpTaz4xxGjHWR-1">
