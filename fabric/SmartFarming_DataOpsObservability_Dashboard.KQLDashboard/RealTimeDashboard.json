      },
      "text": "get_ingress_data_quality_audit(15)\r\n| project \r\n    stream_name, \r\n    total_rows, \r\n    valid_schema_rows, \r\n    null_facility_count, \r\n    null_timestamp_count, \r\n    out_of_bounds_count,\r\n    clock_skew_count,\r\n    Quality_Score = strcat(tostring(data_quality_score), \"%\"),\r\n    SLA_Status = case(\r\n        data_quality_score >= 98.0, \"🟢 COMPLIANT\",\r\n        data_quality_score >= 90.0, \"🟡 DEGRADED\",\r\n        \"🔴 BREACH\"\r\n    )\r\n| sort by total_rows desc\r\n",
