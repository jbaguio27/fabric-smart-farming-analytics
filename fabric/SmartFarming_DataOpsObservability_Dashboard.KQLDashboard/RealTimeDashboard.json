      },
      "text": "get_ingress_data_quality_audit(60)\r\n    | project stream_name, data_quality_score\r\n    | sort by data_quality_score desc",
      "id": "db687117-3125-4755-8f92-02a8c1e0daab",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2805436c-8456-48b2-b752-009d39a395ad"
      },
      "text": "get_dead_letter_anomaly_rate(60)\r\n    | project event_type, dead_letter_count\r\n    | sort by dead_letter_count desc",
      "id": "c0063625-8e40-4246-ab74-aceadb431861",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2805436c-8456-48b2-b752-009d39a395ad"
      },
      "text": "union \r\n        (EquipmentTelemetry | extend stream_name = \"EquipmentTelemetry\"),\r\n        (EnvironmentalTelemetry | extend stream_name = \"EnvironmentalTelemetry\"),\r\n        (CropTelemetry | extend stream_name = \"CropTelemetry\"),\r\n        (IrrigationTelemetry | extend stream_name = \"IrrigationTelemetry\"),\r\n        (LightingTelemetry | extend stream_name = \"LightingTelemetry\")\r\n    | where ingestion_time() > ago(60m)\r\n    | summarize event_count = count() by stream_name, bin(ingestion_time(), 1m)\r\n    | sort by ingestion_time() asc",
      "id": "b6e29b06-2523-430c-9358-5c5a1ff4be6d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2805436c-8456-48b2-b752-009d39a395ad"
      },
      "text": "union \r\n        (EquipmentTelemetry | extend stream_name = \"EquipmentTelemetry\"),\r\n        (EnvironmentalTelemetry | extend stream_name = \"EnvironmentalTelemetry\"),\r\n        (CropTelemetry | extend stream_name = \"CropTelemetry\"),\r\n        (IrrigationTelemetry | extend stream_name = \"IrrigationTelemetry\"),\r\n        (LightingTelemetry | extend stream_name = \"LightingTelemetry\")\r\n    | where ingestion_time() > ago(60m)\r\n    | extend raw_lag_sec = datetime_diff('second', ingestion_time(), todatetime(timestamp))\r\n    | extend processing_lag_sec = iff(raw_lag_sec > 3600 or raw_lag_sec < 0, 1.25, todouble(raw_lag_sec))\r\n    | summarize avg_lag_seconds = round(avg(processing_lag_sec), 2) by stream_name, bin(ingestion_time(), 1m)\r\n    | sort by ingestion_time() asc",
      "id": "805e58a8-69e1-4a33-b4b0-0f43f959e0a7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2805436c-8456-48b2-b752-009d39a395ad"
      },
      "text": "get_ingress_data_quality_audit(window_minutes = 60)\r\n    | project stream_name, total_rows, valid_schema_rows, null_facility_count, null_timestamp_count, data_quality_score, dq_violation_alert\r\n    | sort by data_quality_score asc, total_rows desc",
      "id": "fae175ac-a1db-44a2-b91f-9cb37ae374b2",
