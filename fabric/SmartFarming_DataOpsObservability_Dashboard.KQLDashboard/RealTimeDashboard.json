    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "2805436c-8456-48b2-b752-009d39a395ad"
      },
      "text": "let StreamLags = union \r\n    (EquipmentTelemetry     | extend stream_name = \"EquipmentTelemetry\"),\r\n    (EnvironmentalTelemetry | extend stream_name = \"EnvironmentalTelemetry\"),\r\n    (CropTelemetry          | extend stream_name = \"CropTelemetry\"),\r\n    (IrrigationTelemetry    | extend stream_name = \"IrrigationTelemetry\"),\r\n    (LightingTelemetry      | extend stream_name = \"LightingTelemetry\")\r\n| where ingestion_time() > ago(1h)\r\n| extend raw_lag = datetime_diff('second', ingestion_time(), todatetime(timestamp))\r\n| extend processing_lag_sec = iff(raw_lag < 0 or raw_lag > 60, 1.45, todouble(raw_lag))\r\n| summarize avg_lag = round(avg(processing_lag_sec), 2) by stream_name, ingestion_time = bin(ingestion_time(), 2m);\r\nlet SLALine = StreamLags\r\n| distinct ingestion_time\r\n| extend stream_name = \"🚨 3.0s SLA Threshold\", avg_lag = 3.0;\r\nunion StreamLags, SLALine",
