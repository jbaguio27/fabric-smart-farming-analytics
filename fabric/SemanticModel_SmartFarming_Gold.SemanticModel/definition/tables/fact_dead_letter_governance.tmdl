	measure 'Unregistered Hardware Defects' =
			
			SUM('fact_dead_letter_governance'[unregistered_hardware_defect_count])
		formatString: #,##0
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: fc0d8cda-9742-468f-b029-c9a3c46e20ca

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Ingestion Defects' =
			
			[Missing PK Defects] + [Deprecated Schema Defects] + [Formatting Defects] + [Out of Bounds Defects] + [Timestamp Skew Defects] + [Unregistered Hardware Defects]
		formatString: #,##0
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 51dfd288-f5a5-4b0a-ad43-e835f8a0dfbc

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Auto-Remediated Defects' =
			
			[Deprecated Schema Defects] + [Formatting Defects] + [Timestamp Skew Defects]
		formatString: #,##0
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: f061cf6f-52b8-47ef-92ad-84985fffb7a8

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Auto-Remediation Rate %' =
			
			DIVIDE([Auto-Remediated Defects], [Total Ingestion Defects], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 7dd33b1d-0799-4189-90da-8525668d5242

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Quarantined Defects' =
			
			[Missing PK Defects] + [Out of Bounds Defects] + [Unregistered Hardware Defects]
		formatString: #,##0
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 7553a9dc-941e-49da-9302-ffa66f62175b

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Quarantine Rate %' =
			
			DIVIDE([Quarantined Defects], [Total Ingestion Defects], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 27ca50e6-cf52-421d-a8b8-fe587c025706

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Data Quality Score %' =
			
			1 - DIVIDE([Total Ingestion Defects], [Total Ingestion Defects] + 1000000, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 2fb1be92-8440-48ff-ad89-f30b0095de72

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

