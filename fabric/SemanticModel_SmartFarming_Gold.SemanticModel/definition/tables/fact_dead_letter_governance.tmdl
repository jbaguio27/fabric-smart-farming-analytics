	measure 'Timestamp Skew Defects' =
			
			SUM('fact_dead_letter_governance'[timestamp_sync_defect_count])
		formatString: #,##0
		displayFolder: 🛡️ DataOps & Governance
		lineageTag: 7e536f8f-af23-429d-802c-b1378eba91f6

		changedProperty = DisplayFolder

		changedProperty = Name

