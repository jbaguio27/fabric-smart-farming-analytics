            {
              "text": {
                "value": "DECLARE @tables TABLE (id INT IDENTITY(1,1), table_name VARCHAR(100));\nINSERT INTO @tables (table_name) VALUES \n    ('dim_date'), ('dim_facility'), ('dim_zone'), ('dim_equipment'), ('dim_crop'), ('dim_technician'),\n    ('fact_environmental_daily'), ('fact_equipment_telemetry'), ('fact_crop_yield'), \n    ('fact_irrigation_daily'), ('fact_lighting_dli_daily'), ('fact_maintenance_sla'), ('fact_dead_letter_governance');\n\nDECLARE @i INT = 1, @max INT = (SELECT COUNT(*) FROM @tables);\nDECLARE @tbl VARCHAR(100), @sql NVARCHAR(MAX);\n\nWHILE @i <= @max\nBEGIN\n    SELECT @tbl = table_name FROM @tables WHERE id = @i;\n    SET @sql = N'IF OBJECT_ID(''dbo.' + @tbl + N''', ''U'') IS NOT NULL DROP TABLE dbo.' + @tbl + N'; ' +\n               N'CREATE TABLE dbo.' + @tbl + N' AS SELECT * FROM SmartFarming_Lakehouse.gold.' + @tbl + N';';\n    EXEC sp_executesql @sql;\n    SET @i = @i + 1;\nEND;",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
