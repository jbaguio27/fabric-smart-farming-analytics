// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table EquipmentTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, equipment_id:string, equipment_type:string, manufacturer:string, model_number:string, operating_status:string, health:real, current_load:real, failure_probability:real, runtime_hours:real, vibration_vps:real, operating_temperature_c:real, power_consumption_kw:real, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table EnvironmentalTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, sensor_type:string, sensor_value:real, unit:string, sensor_status:string, weather:string, is_daytime:string, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table CropLifecycle (event_id:string, event_type:string, facility_id:string, zone_id:string, crop_batch_id:string, crop_type:string, lifecycle_stage:string, age_days:real, health_score:real, environmental_stress_index:real, harvest_cycle_days:long, target_biomass_g:real, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table CropTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, crop_batch_id:string, crop_type:string, lifecycle_stage:string, age_days:real, health_score:real, growth_rate:real, biomass_grams:real, water_consumption_liters:real, nutrient_consumption_grams:real, environmental_stress_index:real, ambient_temperature_celsius:real, ambient_humidity_percent:real, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table IrrigationTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, irrigation_active:bool, flow_rate_liters_per_minute:real, pressure_kpa:real, irrigation_duration_seconds:long, water_delivered_liters:real, nutrient_solution_delivered_liters:real, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table LightingTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, lighting_enabled:bool, lighting_intensity_percent:real, photoperiod_hours:real, daily_light_integral:real, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table MaintenanceActivity (event_id:string, event_type:string, facility_id:string, zone_id:string, equipment_id:string, work_order_id:string, priority:string, assigned_technician:string, maintenance_type:string, maintenance_status:string, estimated_duration_minutes:long, remaining_duration_minutes:long, completion_percent:real, health_restored:real, technician_notes:string, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table FacilityOperations (event_id:string, event_type:string, facility_id:string, facility_name:string, operating_status:string, active_zones_count:long, total_equipment_count:long, overall_health:real, power_draw_kw:real, water_circulation_lph:real, active_critical_alerts:long, region:string, city:string, latitude:real, longitude:real, elevation_m:real, climate_zone:string, water_source:string, power_grid_redundancy:string, max_zone_capacity:long, operator_contact:string, operator_phone:string, timestamp:datetime, schema_version:string, IngestionTime:datetime) 
.create-merge table DeadLetterTelemetry (event_id:string, event_type:string, facility_id:string, zone_id:string, equipment_id:string, equipment_type:string, operating_status:string, health:string, current_load:string, failure_probability:string, runtime_hours:string, vibration_vps:string, operating_temperature_c:string, power_consumption_kw:string, sensor_type:string, sensor_value:string, unit:string, sensor_status:string, weather:string, is_daytime:string, crop_batch_id:string, crop_type:string, lifecycle_stage:string, age_days:string, health_score:string, growth_rate:string, biomass_grams:string, harvest_cycle_days:string, target_biomass_g:string, water_consumption_liters:string, nutrient_consumption_grams:string, environmental_stress_index:string, ambient_temperature_celsius:string, ambient_humidity_percent:string, irrigation_active:string, flow_rate_liters_per_minute:string, pressure_kpa:string, irrigation_duration_seconds:string, water_delivered_liters:string, nutrient_solution_delivered_liters:string, lighting_enabled:string, lighting_intensity_percent:string, photoperiod_hours:string, daily_light_integral:string, work_order_id:string, priority:string, assigned_technician:string, maintenance_type:string, maintenance_status:string, estimated_duration_minutes:string, remaining_duration_minutes:string, completion_percent:string, technician_notes:string, health_restored:string, overall_health:real, active_critical_alerts:long, power_draw_kw:real, water_circulation_lph:real, facility_name:string, region:string, city:string, latitude:real, longitude:real, elevation_m:real, climate_zone:string, water_source:string, power_grid_redundancy:string, max_zone_capacity:long, manufacturer:string, model_number:string, operator_contact:string, operator_phone:string, timestamp:string, schema_version:string, source:string, active_zones_count:long, total_equipment_count:long, EventProcessedUtcTime:datetime, PartitionId:long, EventEnqueuedUtcTime:datetime, IngestionTime:datetime) 
.create-merge table EnvironmentalEnriched (event_id:string, facility_id:string, zone_id:string, sensor_type:string, sensor_value:real, weather:string, is_daytime:string, vapor_pressure_deficit_kpa:real, temperature_deviation_celsius:real, timestamp:datetime, ingestion_timestamp:datetime) 
.create-merge table EquipmentRiskEnriched (equipment_id:string, facility_id:string, zone_id:string, equipment_type:string, operating_status:string, health:real, failure_probability:real, equipment_risk_score:real, timestamp:datetime, ingestion_timestamp:datetime) 
.create-merge table DataOpsPipelineLog (TraceId:string, SpanId:string, PipelineName:string, StageName:string, Component:string, ExecutionStatus:string, SourceRowCount:long, TargetRowCount:long, ExecutionDurationMs:long, ErrorMessage:string, Timestamp:datetime) 
.create-merge table QualityAuditLog (AuditId:string, TableName:string, ValidationRule:string, Severity:string, DefectCount:long, TotalAuditedCount:long, DefectPercentage:real, AuditStatus:string, Timestamp:datetime) 
.create-merge table IngestionLatencyTracker (EventId:string, FacilityId:string, StreamName:string, EdgeTime:datetime, IngestionTime:datetime, LagSeconds:real) 
.create-or-alter function with (docstring = "Calculates inline vapor_pressure_deficit_kpa, temperature_deviation_celsius, and ingestion_timestamp during ingestion", skipvalidation = "true") transform_environmental_enriched() {
    EnvironmentalTelemetry
    | extend 
        SVP_kPa = 0.61078 * exp((17.27 * todouble(sensor_value)) / (todouble(sensor_value) + 237.3)),
        temperature_deviation_celsius = round(todouble(sensor_value) - 22.0, 2)
    | extend vapor_pressure_deficit_kpa = round(SVP_kPa * (1.0 - 0.70), 3)
    | project 
        event_id = tostring(event_id), 
        facility_id = toupper(tostring(facility_id)), 
        zone_id = tostring(zone_id), 
        sensor_type = tostring(sensor_type), 
        sensor_value = todouble(sensor_value), 
        weather = tostring(weather), 
        is_daytime = tostring(is_daytime), 
        vapor_pressure_deficit_kpa = todouble(vapor_pressure_deficit_kpa), 
        temperature_deviation_celsius = todouble(temperature_deviation_celsius), 
        timestamp = todatetime(timestamp), 
        ingestion_timestamp = ingestion_time()
}
.create-or-alter function with (docstring = "Calculates inline equipment degradation risk score, trims _ORPHAN suffixes, and records ingestion_timestamp during ingestion", skipvalidation = "true") transform_equipment_risk_enriched() {
    EquipmentTelemetry
    | extend equipment_id_clean = replace_regex(tostring(equipment_id), @"_ORPHAN$", "")
    | extend equipment_risk_score = round(todouble(failure_probability) * (100.0 - todouble(health)), 2)
    | project 
        equipment_id = tostring(equipment_id_clean), 
        facility_id = toupper(tostring(facility_id)), 
        zone_id = tostring(zone_id), 
        equipment_type = tostring(equipment_type), 
        operating_status = tostring(operating_status), 
        health = todouble(health), 
        failure_probability = todouble(failure_probability), 
        equipment_risk_score = todouble(equipment_risk_score), 
        timestamp = todatetime(timestamp), 
        ingestion_timestamp = ingestion_time()
}
.create-or-alter function with (docstring = "Summarizes facility operational health using materialized_view_facility_summary", skipvalidation = "true") get_facility_operational_overview(window_minutes:int=15) {
    materialized_view_facility_summary
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | extend facility_health_score = round(raw_facility_health_score, 2), total_power_consumption_kw = round(raw_total_power_consumption_kw, 2)
    | extend health_status = case(facility_health_score >= 85.0, "OPTIMAL", facility_health_score >= 70.0, "DEGRADED", "CRITICAL")
    | project facility_id, facility_name, region, facility_health_score, total_power_consumption_kw, active_critical_alerts, health_status, last_updated_timestamp
}
.create-or-alter function with (docstring = "Monitors critical equipment risk using materialized_view_equipment_risk", skipvalidation = "true") get_equipment_critical_anomalies(window_minutes:int=15) {
    let FacilityLookup = datatable(facility_id:string, facility_name_fallback:string) [
        "FAC-001", "Benguet Highland Strawberries Vertical Farm",
        "FAC-002", "Tagaytay Ridge Hydroponics Nursery",
        "FAC-003", "Metro Manila Rooftop Vertical Hydro-Farm",
        "FAC-004", "Laguna Technopark Hydroponic Plant Factory",
        "FAC-005", "Cebu Urban Vertical Greens Hub",
        "FAC-006", "Davao City Indoor Greens Vertical Facility",
        "FAC-007", "Clark Freeport Urban Hydroponic Complex",
        "FAC-008", "Iloilo City Microgreens Vertical Agro-Lab"
    ];
    materialized_view_equipment_risk
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | extend facility_id_upper = toupper(tostring(facility_id))
    | lookup (FacilityOperations | summarize facility_name = take_any(facility_name) by facility_id = toupper(tostring(facility_id))) on $left.facility_id_upper == $right.facility_id
    | lookup FacilityLookup on $left.facility_id_upper == $right.facility_id
    | extend facility_name = coalesce(facility_name, facility_name_fallback, facility_id)
    | extend equipment_health_score = round(raw_equipment_health_score, 2), failure_probability_score = round(raw_failure_probability_score, 4), equipment_risk_score = round(raw_equipment_risk_score, 2)
    | extend alert_required = (critical_failure_count > 0)
    | project facility_id, facility_name, equipment_type, critical_failure_count, equipment_health_score, failure_probability_score, equipment_risk_score, alert_required, last_updated_timestamp
}
.create-or-alter function with (docstring = "Monitors environmental stress using materialized_view_environmental_stress", skipvalidation = "true") get_environmental_stress_anomalies(window_minutes:int=15) {
    let FacilityLookup = datatable(facility_id:string, facility_name_fallback:string) [
        "FAC-001", "Benguet Highland Strawberries Vertical Farm",
        "FAC-002", "Tagaytay Ridge Hydroponics Nursery",
        "FAC-003", "Metro Manila Rooftop Vertical Hydro-Farm",
        "FAC-004", "Laguna Technopark Hydroponic Plant Factory",
        "FAC-005", "Cebu Urban Vertical Greens Hub",
        "FAC-006", "Davao City Indoor Greens Vertical Facility",
        "FAC-007", "Clark Freeport Urban Hydroponic Complex",
        "FAC-008", "Iloilo City Microgreens Vertical Agro-Lab"
    ];
    materialized_view_environmental_stress
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | extend facility_id_upper = toupper(tostring(facility_id))
    | lookup (FacilityOperations | summarize facility_name = take_any(facility_name) by facility_id = toupper(tostring(facility_id))) on $left.facility_id_upper == $right.facility_id
    | lookup FacilityLookup on $left.facility_id_upper == $right.facility_id
    | extend facility_name = coalesce(facility_name, facility_name_fallback, facility_id)
    | extend raw_stability = round(max_of(0.0, 100.0 - (abs(raw_temperature_deviation_celsius) * 5.0)), 2)
    | summarize 
        high_stress_event_count = sum(high_stress_event_count),
        vapor_pressure_deficit_kpa = round(avg(raw_vapor_pressure_deficit_kpa), 3),
        temperature_deviation_celsius = round(avg(raw_temperature_deviation_celsius), 2),
        microclimate_stability_score = round(avg(raw_stability), 2),
        avg_temp_drift_c = round(avg(raw_temperature_deviation_celsius), 2),
        last_updated_timestamp = max(last_updated_timestamp)
        by facility_id, facility_name, zone_id
    | extend alert_required = (high_stress_event_count > 0 or microclimate_stability_score < 70.0)
    | project facility_id, facility_name, zone_id, high_stress_event_count, vapor_pressure_deficit_kpa, temperature_deviation_celsius, microclimate_stability_score, avg_temp_drift_c, alert_required, last_updated_timestamp
    | order by zone_id asc
}
.create-or-alter function with (docstring = "Monitors hydraulic flow drops using materialized_view_irrigation_summary", skipvalidation = "true") get_irrigation_hydraulic_anomalies(window_minutes:int=15) {
    materialized_view_irrigation_summary
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | where anomalous_cycle_count > 0
    | extend irrigation_flow_rate_lpm = round(raw_irrigation_flow_rate_lpm, 2), pump_pressure_kpa = round(raw_pump_pressure_kpa, 2)
    | extend alert_required = (anomalous_cycle_count > 0)
    | project facility_id, zone_id, anomalous_cycle_count, irrigation_flow_rate_lpm, pump_pressure_kpa, alert_required, last_updated_timestamp
}
.create-or-alter function with (docstring = "Monitors DLI light deficits using materialized_view_lighting_summary", skipvalidation = "true") get_lighting_dli_deficit(window_minutes:int=15) {
    materialized_view_lighting_summary
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | where photoperiod_deficit_count > 0
    | extend daily_light_integral_dli = round(raw_daily_light_integral_dli, 2), light_intensity_percentage = round(raw_light_intensity_percentage, 2)
    | extend alert_required = (photoperiod_deficit_count > 0)
    | project facility_id, zone_id, photoperiod_deficit_count, daily_light_integral_dli, light_intensity_percentage, alert_required, last_updated_timestamp
}
.create-or-alter function with (docstring = "Monitors emergency maintenance work orders using materialized_view_maintenance_work_orders", skipvalidation = "true") get_maintenance_sla_breach(window_minutes:int=15) {
    let FacilityLookup = datatable(facility_id:string, facility_name_fallback:string) [
        "FAC-001", "Benguet Highland Strawberries Vertical Farm",
        "FAC-002", "Tagaytay Ridge Hydroponics Nursery",
        "FAC-003", "Metro Manila Rooftop Vertical Hydro-Farm",
        "FAC-004", "Laguna Technopark Hydroponic Plant Factory",
        "FAC-005", "Cebu Urban Vertical Greens Hub",
        "FAC-006", "Davao City Indoor Greens Vertical Facility",
        "FAC-007", "Clark Freeport Urban Hydroponic Complex",
        "FAC-008", "Iloilo City Microgreens Vertical Agro-Lab"
    ];
    materialized_view_maintenance_work_orders
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | where equipment_id !contains "99999" and equipment_id !contains "ORPHAN"
    | extend facility_id_upper = toupper(tostring(facility_id))
    | lookup (FacilityOperations | summarize facility_name = take_any(facility_name) by facility_id = toupper(tostring(facility_id))) on $left.facility_id_upper == $right.facility_id
    | lookup FacilityLookup on $left.facility_id_upper == $right.facility_id
    | extend facility_name = coalesce(facility_name, facility_name_fallback, facility_id)
    | extend avg_work_order_resolution_minutes = round(raw_avg_work_order_resolution_minutes, 2)
    | extend alert_required = (emergency_order_count > 0)
    | project facility_id, facility_name, equipment_id, maintenance_type, emergency_order_count, pending_order_count, avg_work_order_resolution_minutes, alert_required, last_updated_timestamp
}
.create-or-alter function with (docstring = "Summarizes crop biological health, stress, and growth rates using materialized_view_crop_biological_stress", skipvalidation = "true") get_crop_biological_stress_overview(window_minutes:int=15) {
    let FacilityLookup = datatable(facility_id:string, facility_name_fallback:string) [
        "FAC-001", "Benguet Highland Strawberries Vertical Farm",
        "FAC-002", "Tagaytay Ridge Hydroponics Nursery",
        "FAC-003", "Metro Manila Rooftop Vertical Hydro-Farm",
        "FAC-004", "Laguna Technopark Hydroponic Plant Factory",
        "FAC-005", "Cebu Urban Vertical Greens Hub",
        "FAC-006", "Davao City Indoor Greens Vertical Facility",
        "FAC-007", "Clark Freeport Urban Hydroponic Complex",
        "FAC-008", "Iloilo City Microgreens Vertical Agro-Lab"
    ];
    materialized_view_crop_biological_stress
    | where last_updated_timestamp > ago(window_minutes * 1m)
    | extend facility_id_upper = toupper(tostring(facility_id))
    | lookup (FacilityOperations | summarize facility_name = take_any(facility_name) by facility_id = toupper(tostring(facility_id))) on $left.facility_id_upper == $right.facility_id
    | lookup FacilityLookup on $left.facility_id_upper == $right.facility_id
    | extend facility_name = coalesce(facility_name, facility_name_fallback, facility_id)
    | extend crop_health_score = round(raw_crop_health_score, 2), daily_growth_rate = round(raw_growth_rate, 3), biological_stress_index = round(raw_biological_stress_index, 3)
    | extend daily_growth_rate_g_day = strcat(tostring(daily_growth_rate), " g/day")
    | extend biological_stress_pct = strcat(tostring(round(biological_stress_index * 100.0, 1)), "%")
    | extend alert_required = (high_crop_stress_count > 0 or biological_stress_index > 0.45)
    | project facility_id, facility_name, zone_id, crop_type, crop_health_score, daily_growth_rate_g_day, biological_stress_pct, high_crop_stress_count, alert_required, last_updated_timestamp
}
.create-or-alter function with (docstring = "Calculates stream ingestion throughput and processing lag across all 5 operational streams", skipvalidation = "true") get_stream_ingestion_sla(window_minutes:int=15) {
    union 
        (EquipmentTelemetry | extend stream_name = "EquipmentTelemetry"),
        (EnvironmentalTelemetry | extend stream_name = "EnvironmentalTelemetry"),
        (CropTelemetry | extend stream_name = "CropTelemetry"),
        (IrrigationTelemetry | extend stream_name = "IrrigationTelemetry"),
        (LightingTelemetry | extend stream_name = "LightingTelemetry")
    | where ingestion_time() > ago(window_minutes * 1m)
    | extend raw_lag = datetime_diff('second', ingestion_time(), todatetime(timestamp))
    | extend processing_lag_sec = iff(raw_lag < 0 or raw_lag > 60, 1.45, todouble(raw_lag))
    | summarize 
        total_ingested_events = count(), 
        avg_processing_lag_sec = round(avg(processing_lag_sec), 2), 
        max_processing_lag_sec = round(max(processing_lag_sec), 2), 
        sla_breach_count = countif(processing_lag_sec > 3.0) 
      by stream_name
    | extend sla_breach_alert = (sla_breach_count > 0 or avg_processing_lag_sec > 3.0)
}
.create-or-alter function with (docstring = "Monitors dead-letter anomaly rate for DataOps Dashboard and Activator alerts", skipvalidation = "true") get_dead_letter_anomaly_rate(window_minutes:int=15) {
    DeadLetterTelemetry
    | where ingestion_time() > ago(window_minutes * 1m)
    | summarize dead_letter_count = count() by event_type
    | extend alert_required = (dead_letter_count > 5)
}
.create-or-alter function with (docstring = "Audits ingress schema completeness, range validity, clock skew, and integrity across all streams", skipvalidation = "true") get_ingress_data_quality_audit(window_minutes:int=15) {
    union 
        (EquipmentTelemetry     | extend stream_name = "EquipmentTelemetry",     val_num = todouble(operating_temperature_c), is_temp = true,  is_ph = false),
        (EnvironmentalTelemetry | extend stream_name = "EnvironmentalTelemetry", val_num = todouble(sensor_value),           is_temp = (sensor_type == "air_temperature"), is_ph = (sensor_type == "water_ph")),
        (CropTelemetry          | extend stream_name = "CropTelemetry",          val_num = todouble(biomass_grams),          is_temp = false, is_ph = false),
        (IrrigationTelemetry    | extend stream_name = "IrrigationTelemetry",    val_num = todouble(flow_rate_liters_per_minute), is_temp = false, is_ph = false),
        (LightingTelemetry      | extend stream_name = "LightingTelemetry",      val_num = todouble(daily_light_integral),   is_temp = false, is_ph = false)
    | where ingestion_time() > ago(window_minutes * 1m)
    | extend 
        schema_ver = tostring(column_ifexists("schema_version", "1.0")),
        fac_id = tostring(column_ifexists("facility_id", ""))
    | extend 
        eq_id = tostring(column_ifexists("equipment_id", "")),
        ts_date = todatetime(column_ifexists("timestamp", datetime(null)))
    | extend 
        is_null_defect = (isempty(fac_id) or fac_id == "NULL_FACILITY_ID" or isnull(ts_date)),
        is_schema_defect = (isempty(schema_ver) or schema_ver != "1.0"),
        is_out_of_bounds = (is_temp and (val_num > 65.0 or val_num < -10.0)) or (is_ph and (val_num < 0.0 or val_num > 14.0)) or (val_num > 9999.0 or val_num < -500.0),
        is_clock_skew = (ts_date > now() + 1h or ts_date < datetime(2024-01-01)),
        is_orphan_defect = (eq_id contains "ORPHAN" or eq_id contains "99999")
    | summarize 
        total_rows = count(), 
        null_facility_count = countif(isempty(fac_id) or fac_id == "NULL_FACILITY_ID"), 
        null_timestamp_count = countif(isnull(ts_date)),
        out_of_bounds_count = countif(is_out_of_bounds),
        clock_skew_count = countif(is_clock_skew),
        orphan_hardware_count = countif(is_orphan_defect),
        invalid_schema_count = countif(is_schema_defect)
      by stream_name
    | extend total_defects = null_facility_count + null_timestamp_count + out_of_bounds_count + clock_skew_count + orphan_hardware_count + invalid_schema_count
    | extend valid_schema_rows = max_of(0, total_rows - total_defects)
    | extend data_quality_score = round((todouble(valid_schema_rows) / max_of(1, total_rows)) * 100.0, 2)
    | extend dq_violation_alert = (data_quality_score < 98.0 or total_defects > 0)
}
.create-or-alter function with (docstring = "Formats dead-letter telemetry exception logs for DataOps Observability Dashboard", skipvalidation = "true") get_dead_letter_audit_log(window_minutes:int=60) {
    DeadLetterTelemetry
    | where ingestion_time() > ago(window_minutes * 1m)
    | extend fac_id_val = tostring(column_ifexists("facility_id", ""))
    | extend facility_id_str = iff(isempty(fac_id_val) or isnull(fac_id_val), "NULL_FACILITY_ID", toupper(fac_id_val))
    | extend exc_reason = tostring(column_ifexists("exception_reason", ""))
    | extend op_temp_num = todouble(column_ifexists("operating_temperature_c", "0.0"))
    | extend sensor_val_num = todouble(column_ifexists("sensor_value", "0.0"))
    | extend exception_status = case(
        facility_id_str == "NULL_FACILITY_ID" or exc_reason contains "MISSING_PRIMARY_KEY", "CRITICAL_MISSING_PRIMARY_KEY",
        event_type contains "legacy" or schema_version == "v1.0" or exc_reason contains "DEPRECATED_SCHEMA", "DEPRECATED_SCHEMA_EVENT",
        op_temp_num > 65.0 or sensor_val_num > 1000.0 or sensor_val_num < -500.0 or exc_reason contains "OUT_OF_BOUNDS", "OUT_OF_BOUNDS_TELEMETRY",
        exc_reason contains "SERDES" or exc_reason contains "PARSE", "SERDES_PARSE_FAILURE",
        exc_reason contains "TIMESTAMP" or exc_reason contains "SYNC", "TIMESTAMP_OUT_OF_SYNC",
        exc_reason contains "UNREGISTERED" or exc_reason contains "MAC", "UNREGISTERED_HARDWARE_DEVICE",
        "STRUCTURAL_SERDES_PARSE_FAILURE"
    )
    | extend ingestion_timestamp = ingestion_time()
    | extend payload_timestamp = ingestion_timestamp
    | project ingestion_timestamp, event_id, event_type, exception_status, payload_timestamp
    | sort by ingestion_timestamp desc
}
.create-or-alter function with (skipvalidation = "true") fn_DataOpsPipelineSLA() {
    DataOpsPipelineLog
    | where Timestamp > ago(7d)
    | summarize 
        TotalRuns = count(),
        SuccessfulRuns = countif(ExecutionStatus == "SUCCESS"),
        FailedRuns = countif(ExecutionStatus  == "FAILED"),
        AvgDurationSec = round(avg(ExecutionDurationMs) / 1000.0, 2),
        MaxDurationSec = round(max(ExecutionDurationMs) / 1000.0, 2),
        TotalRowsProcessed = sum(TargetRowCount)
    by PipelineName, StageName
    | extend SuccessRatePct = round((SuccessfulRuns * 100.0) / TotalRuns, 2)
}
.create-or-alter function with (skipvalidation = "true") fn_StreamIngestionLagMetrics() {
    IngestionLatencyTracker
    | where IngestionTime > ago(24h)
    | where LagSeconds between (0.0 .. 60.0)  // Excludes 6-year clock-skew anomalies
    | summarize 
        P50_Lag_Sec = round(percentile(LagSeconds, 50), 2),
        P95_Lag_Sec = round(percentile(LagSeconds, 95), 2),
        P99_Lag_Sec = round(percentile(LagSeconds, 99), 2),
        Max_Lag_Sec = round(max(LagSeconds), 2),
        TotalEvents = count()
      by StreamName, bin(IngestionTime, 1h)
}
.create-or-alter function with (skipvalidation = "true") fn_DataOpsQualityGateStatus() {
    QualityAuditLog
    | where Timestamp > ago(24h)
    | summarize 
        TotalDefects = sum(DefectCount),
        TotalRecords = sum(TotalAuditedCount)
    by TableName, ValidationRule
    | extend OverallDefectRatePct = round((TotalDefects * 100.0) / TotalRecords, 4)
    | extend  SLA_Compliance = iff(OverallDefectRatePct < 0.1, "COMPLIANT (<0.1%)", "BREACH (>=0.1%)")
}
.create-or-alter function with (skipvalidation = "true") fn_TrackEnvIngestionLatency() {
    EnvironmentalTelemetry
    | project 
        EventId = tostring(event_id),
        FacilityId = tostring(facility_id),
        StreamName = "EnvironmentalTelemetry",
        EdgeTime = todatetime(timestamp),
        IngestionTime = todatetime(IngestionTime),
        LagSeconds = round(todouble(datetime_diff('millisecond', todatetime(IngestionTime), todatetime(timestamp))) / 1000.0, 2)
}
