# =====================================================================
# Microsoft Fabric Resources
# =====================================================================

# Fabric Workspace Name (e.g., fabric-smart-farming-analytics-dev)
FABRIC_WORKSPACE=fabric-smart-farming-analytics-dev

# Eventstream Custom App / Event Hub Ingestion Endpoint & Connection String
EVENTHUB_NAME=your_eventstream_custom_app_entity_name
CONNECTION_STR=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=your-key-name;SharedAccessKey=your-key-secret;EntityPath=your_entity_name

# Fabric Item Names
EVENTSTREAM_NAME=FarmingTelemetryEventstream
EVENTHOUSE_NAME=SmartFarmingEventhouse
KQL_DATABASE=SmartFarmingKQLDB
LAKEHOUSE_NAME=SmartFarming_Lakehouse
WAREHOUSE_NAME=SmartFarming_Warehouse
POWERBI_WORKSPACE=fabric-smart-farming-analytics-dev

# =====================================================================
# Application Configuration
# =====================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# =====================================================================
# Simulator Configuration
# =====================================================================

SIMULATION_INTERVAL_SECONDS=5
SIMULATION_CYCLE_HOURS=1.0
SIMULATION_TIME_STEP_MINUTES=5
EVENT_BATCH_SIZE=100
RANDOM_SEED=42
ENABLE_INGESTION_ANOMALIES=true

# =====================================================================
# Facility Configuration
# =====================================================================

TOTAL_FACILITIES=8
ZONE_COUNT=10
EQUIPMENT_TELEMETRY_SAMPLE_RATE=0.10
