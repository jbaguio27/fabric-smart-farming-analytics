# ==============================================================================
# HydroGrow: Microsoft Fabric Smart Farming Real-Time Analytics Platform
# Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env` (or `copy .env.example .env` on Windows)
# 2. Fill in your Microsoft Fabric workspace and Eventstream credentials below.
# 3. Never commit your active .env file to Git!
# ==============================================================================

# ==============================================================================
# 1. Microsoft Fabric Workspace & Item Identification
# ==============================================================================

# Name of your development workspace in Microsoft Fabric
FABRIC_WORKSPACE=fabric-smart-farming-analytics-dev

# Eventstream Custom App / Event Hub Ingestion Endpoint & Connection String
# -> Where to find in Fabric: Open Eventstream -> Select "Custom App" Source -> View "Keys"
EVENTHUB_NAME=your_eventstream_custom_app_entity_name
CONNECTION_STR=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=your-key-name;SharedAccessKey=your-key-secret;EntityPath=your_entity_name

# Microsoft Fabric Core Item Names (Must match workspace artifact names)
EVENTSTREAM_NAME=FarmingTelemetryEventstream
EVENTHOUSE_NAME=SmartFarmingEventhouse
KQL_DATABASE=SmartFarmingKQLDB
LAKEHOUSE_NAME=SmartFarming_Lakehouse
WAREHOUSE_NAME=SmartFarming_Warehouse
POWERBI_WORKSPACE=fabric-smart-farming-analytics-dev

# ==============================================================================
# 2. Application & Runtime Configuration
# ==============================================================================

# Deployment environment: development | test | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# 3. IoT Simulator Engine Parameters
# ==============================================================================

# Real-time event emission cadence in seconds
SIMULATION_INTERVAL_SECONDS=5

# Duration of each simulation cycle in hours
SIMULATION_CYCLE_HOURS=1.0

# Granularity of simulated telemetry readings in minutes
SIMULATION_TIME_STEP_MINUTES=5

# Batch size of records dispatched per network payload
EVENT_BATCH_SIZE=100

# Seed for deterministic random number generation (reproducible testing)
RANDOM_SEED=42

# Toggle injection of real-time anomalies for testing Fabric Activator alerts (true | false)
ENABLE_INGESTION_ANOMALIES=true

# ==============================================================================
# 4. Multi-Facility Agricultural Topology
# ==============================================================================

# Number of indoor vertical farming facilities simulated (Default: 8)
TOTAL_FACILITIES=8

# Number of microclimate growing zones per facility (Default: 10)
ZONE_COUNT=10

# Sampling rate for heavy equipment telemetry metrics (0.0 to 1.0)
EQUIPMENT_TELEMETRY_SAMPLE_RATE=0.10
